PORT=3000
NODE_ENV=development
JWT_SECRET=sakukampus-team7-secret-key-2026
COOKIE_SECRET=sakukampus-cookie-secret-2026
# Kuota Chat Harian (Gunakan 50 untuk standar, atau 0 / unlimited jika ingin tanpa batas kuota)
DAILY_CHAT_LIMIT=50

# Instruksi Tambahan Kustom SakuBot (Opsional: tambahkan arahan gaya bahasa atau aturan khusus)
SAKUBOT_CUSTOM_INSTRUCTIONS="Selalu berikan estimasi jatah belanja harian mahasiswa dan rekomendasi tips hemat kreatif di Yogyakarta."

# Google OAuth 2.0 Credentials (Optional for local testing; demo login is active by default)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Gemini API Key (Optional for complex NLP fallback; rule parser works offline!)
GEMINI_API_KEY=your_gemini_api_key_here
